# Backend API base URL. The trailing slash is required -- the code
# concatenates paths directly, e.g. `${API_URL}events/${id}`.
API_URL='http://your-backend-host:8899/api/'

# Base origin of THIS app, with no path. In production this must be the
# deployed URL (e.g. https://gatherly.example.com) or NextAuth callbacks break.
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Knock server-side API key (https://dashboard.knock.app)
KNOCK_SECRET_API_KEY=
